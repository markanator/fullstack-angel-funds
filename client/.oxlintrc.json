{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y", "nextjs", "import"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "eslint/no-underscore-dangle": "off"
  },
  "ignorePatterns": [
    "generated/**",
    ".next/**",
    "node_modules/**",
    "next.config.js",
    "next-sitemap.config.js"
  ]
}
